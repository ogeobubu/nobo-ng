{
  "name": "nobong-assessment",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:docker": "docker compose up --build",
    "dev:backend": "yarn workspace @nobong/backend dev",
    "dev:frontend": "yarn workspace @nobong/frontend dev",
    "dev:mobile": "yarn workspace @nobong/mobile start",
    "start:backend": "yarn workspace @nobong/backend start",
    "build:frontend": "yarn workspace @nobong/frontend build",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down -v"
  }
}
